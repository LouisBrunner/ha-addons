#!/command/with-contenv bashio
# shellcheck shell=bash
set -e

source /etc/s6-overlay/scripts/logging.sh

mkdir -p /data

if ! bashio::fs.file_exists /data/glance.yml; then
	bashio::log.info "First run: generating glance.yml..."
	cp /etc/glance/glance.yml.default /data/glance.yml
else
	bashio::log.info "Using existing /data/glance.yml"
fi

bashio::log.info "Starting Glance on 127.0.0.1:8080..."
cd /data
exec glance --config /data/glance.yml
