#!/command/with-contenv bashio
# shellcheck shell=bash
set -e

source /etc/s6-overlay/scripts/logging.sh

mkdir -p /data

export YARR_ADDR=127.0.0.1:7070
export YARR_DB=/data/yarr.db

FEVER_AUTH_FILE=/data/fever_auth
if ! bashio::fs.file_exists "${FEVER_AUTH_FILE}"; then
	bashio::log.info "First run: generating Fever API credentials..."
	fever_password="$(openssl rand -hex 16)"
	printf 'fever:%s' "${fever_password}" >"${FEVER_AUTH_FILE}"
	chmod 600 "${FEVER_AUTH_FILE}"
fi
export YARR_AUTH
YARR_AUTH="$(cat "${FEVER_AUTH_FILE}")"
bashio::log.info "Fever API username is 'fever', password is in ${FEVER_AUTH_FILE}"

if bashio::config.has_value 'base_path'; then
	YARR_BASE="$(bashio::config 'base_path')"
	export YARR_BASE
	bashio::log.info "Base path set to ${YARR_BASE}"
fi

bashio::log.info "Starting yarr on ${YARR_ADDR}..."
print_env
exec yarr
