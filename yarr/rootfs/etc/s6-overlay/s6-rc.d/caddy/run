#!/command/with-contenv bashio
# shellcheck shell=bash
set -e

source /etc/s6-overlay/scripts/logging.sh

bashio::config.require 'hostname'
HOSTNAME="$(bashio::config 'hostname')"
if [[ "${HOSTNAME}" == *"://"* || "${HOSTNAME}" == *"/"* ]]; then
	bashio::log.fatal "hostname must not include a scheme or path, e.g. 'rss.mydomain.com' not 'https://rss.mydomain.com/'"
	exit 1
fi

bashio::log.debug "Full config: $(bashio::addon.config | jq '.oidc.client_secret = "***REDACTED***"')"

bashio::log.info "Waiting for Fever API credentials..."
FEVER_AUTH_FILE=/data/fever_auth
until [[ -s "${FEVER_AUTH_FILE}" ]]; do
	sleep 1
done
fever_username="$(cut -d: -f1 <"${FEVER_AUTH_FILE}")"
fever_password="$(cut -d: -f2- <"${FEVER_AUTH_FILE}")"
# Mirrors yarr's own auth cookie derivation (src/server/auth/auth.go): hex(HMAC-SHA256(key=password, msg=username))
auth_cookie_hmac="$(printf '%s' "${fever_username}" | openssl dgst -sha256 -hmac "${fever_password}" -r | awk '{print $1}')"

bashio::log.info "Generating Caddyfile from template"
bashio::addon.config \
	| jq --arg user "${fever_username}" --arg hmac "${auth_cookie_hmac}" '. + {yarr_auth_cookie: ($user + ":" + $hmac)}' \
	| tempio -template /etc/caddy/Caddyfile.gtpl -out /etc/caddy/Caddyfile
bashio::log.debug "Caddyfile: $(cat /etc/caddy/Caddyfile)"

bashio::log.info "Starting Caddy on 3000..."
print_env
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
